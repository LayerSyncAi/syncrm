# The Convex deployment the app talks to (the same one as the website).
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# The website, used for the AI assistant and password-reset links.
EXPO_PUBLIC_WEB_URL=https://app.syncrm.com
# Optional: Google Places suggestions in location fields (the website uses
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY). Use a key restricted to the iOS and Android
# apps, not to web referrers. Without it, location is a plain text field.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
